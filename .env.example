# Скопируйте в .env (для docker compose) или в backend/.env (для запуска без Docker).
# Все переменные необязательные — без них проект запускается в демо-режиме.

# --- База данных (без Docker по умолчанию SQLite-файл backend/harvestpay.db) ---
# HP_DATABASE_URL=postgresql+psycopg://harvestpay:harvestpay@localhost:5432/harvestpay

# --- Фоновые задачи: background (без Redis) или celery (нужен Redis + запущенный воркер) ---
# HP_TASK_MODE=background
# HP_REDIS_URL=redis://localhost:6379/0

# --- Спутниковые данные: mock (демо), cdse (Copernicus Data Space, бесплатно) или gee (Google Earth Engine) ---
HP_SATELLITE_PROVIDER=mock
# HP_CDSE_CLIENT_ID=sh-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx   # OAuth-клиент из dashboard CDSE, см. README
# HP_CDSE_CLIENT_SECRET=...
# HP_GEE_PROJECT=my-gcp-project-id
# HP_GEE_SERVICE_ACCOUNT=harvestpay@my-gcp-project-id.iam.gserviceaccount.com
# HP_GEE_KEY_FILE=/secrets/gee-key.json     # в Docker; без Docker — путь на вашем диске

# --- Климат и влажность почвы: openmeteo (бесплатно, без ключа) или off (не ходить в интернет) ---
# В демо-режиме заменяет синтетический климат настоящим, у реальных провайдеров дополняет пропуски.
HP_CLIMATE_PROVIDER=openmeteo

# --- Реестр юрлиц: mock (демо) или statgov (stat.gov.kz, экспериментально) ---
HP_REGISTRY_PROVIDER=mock

# --- Порты Docker-стенда на вашем компьютере (поменяйте, если заняты другим проектом) ---
HP_WEB_PORT=8080
HP_API_PORT=8000

# --- Андеррайтинг ---
# HP_LIMIT_PER_HA=60000                 # ₸ на гектар — базовая норма лимита
# HP_MIN_COMPANY_AGE_MONTHS=12          # моложе — отказ
# HP_CLASS_A_MIN_AGE_MONTHS=24          # моложе — не выше класса B
# HP_MAX_TAX_DEBT=100000                # налоговый долг больше — отказ, меньше — предупреждение
# HP_MAX_LIMIT_A=20000000               # потолок лимита на заявку для класса A
# HP_MAX_LIMIT_B=10000000               # и для класса B

# --- Фондирование: кредитная линия банка-партнёра ---
# HP_CREDIT_LINE_BANK=Банк-партнёр (демо)
# HP_CREDIT_LINE_LIMIT=500000000
# HP_CREDIT_LINE_RATE=0.17              # годовая ставка

# --- Прочее ---
HP_ANALYST_TOKEN=analyst-demo-token
