# Скопируйте в .env (для docker compose) или в backend/.env (для запуска без Docker).
# Все переменные необязательные — без них проект запускается в демо-режиме.

# --- База данных (без Docker по умолчанию SQLite-файл backend/harvestpay.db) ---
# HP_DATABASE_URL=postgresql+psycopg://harvestpay:harvestpay@localhost:5432/harvestpay

# --- Фоновые задачи: background (без Redis) или celery (нужен Redis + запущенный воркер) ---
# HP_TASK_MODE=background
# HP_REDIS_URL=redis://localhost:6379/0

# --- Спутниковые данные: mock (демо) или gee (Google Earth Engine) ---
HP_SATELLITE_PROVIDER=mock
# HP_GEE_PROJECT=my-gcp-project-id
# HP_GEE_SERVICE_ACCOUNT=harvestpay@my-gcp-project-id.iam.gserviceaccount.com
# HP_GEE_KEY_FILE=/secrets/gee-key.json     # в Docker; без Docker — путь на вашем диске

# --- Реестр юрлиц: mock (демо) или statgov (stat.gov.kz, экспериментально) ---
HP_REGISTRY_PROVIDER=mock

# --- Порты Docker-стенда на вашем компьютере (поменяйте, если заняты другим проектом) ---
HP_WEB_PORT=8080
HP_API_PORT=8000

# --- Прочее ---
HP_ANALYST_TOKEN=analyst-demo-token
# HP_LIMIT_PER_HA=60000
# HP_MIN_COMPANY_AGE_MONTHS=12
